{
	"name": "obsidian-single-page-pdf",
	"version": "1.0.1",
	"description": "Export notes as single-page PDF without page breaks. Height is auto-calculated from content.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	  "keywords": [
    "obsidian",
    "pdf",
    "single-page",
    "export"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "electron": "^43.3.0",
    "esbuild": "^0.28.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^16.0.0",
    "obsidian": "latest",
    "typescript": "^5.9.2"
  }
}
